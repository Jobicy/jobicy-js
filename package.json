{
  "name": "@jobicy/jobs",
  "version": "0.1.0",
  "description": "Reusable zero-dependency JavaScript client for the public Jobicy remote jobs API",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check examples/search.js && node --check examples/filter.js && node --check examples/export-json.js && node --check examples/pagination.js && node --check examples/status.js",
    "example:search": "node examples/search.js",
    "example:filter": "node examples/filter.js",
    "example:export": "node examples/export-json.js",
    "example:pagination": "node examples/pagination.js",
    "example:status": "node examples/status.js",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 tests/types.test.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jobicy/jobicy-js.git"
  },
  "homepage": "https://github.com/Jobicy/jobicy-js#readme",
  "bugs": {
    "url": "https://github.com/Jobicy/jobicy-js/issues"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "PROVENANCE.md"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
